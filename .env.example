# Copy this file to .env and adjust as needed. All values shown are defaults.

# Path to the text corpus that gets embedded and indexed.
RAG_CORPUS_PATH=data/corpus.txt

# Embedding model backends.
BERT_MODEL_NAME=bert-base-uncased
DPR_CONTEXT_MODEL_NAME=facebook/dpr-ctx_encoder-single-nq-base
DPR_QUESTION_MODEL_NAME=facebook/dpr-question_encoder-single-nq-base

# Generation model. GPT-2 runs on CPU with no API key -- see README
# "Design Decisions & Tradeoffs" for what a production system would use.
GENERATOR_MODEL_NAME=gpt2

# Flask server
PORT=5000
FLASK_DEBUG=false
